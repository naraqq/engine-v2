{
    "name": "engine-v2",
    "version": "1.0.0",
    "description": "Manga Downloader REST API - supports 788+ manga sources",
    "type": "module",
    "license": "Unlicense",
    "engines": {
        "node": ">=22.13.0",
        "npm": ">=10.9.2"
    },
    "main": "dist/index.js",
    "scripts": {
        "dev": "node --loader ./loader.mjs --import tsx --watch src/index.ts",
        "build": "tsc && tsc-alias",
        "build:prod": "tsc --project tsconfig.prod.json && tsc-alias",
        "start": "node --loader ./loader.mjs dist/index.js",
        "lint": "eslint src --ext .ts",
        "test": "vitest run",
        "download": "node ./scripts/download.mjs",
        "translate": "tsx src/translator/cli.ts",
        "update-website-index": "node ./scripts/website-index.mjs"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^1.8.0",
        "@google/genai": "^3.1.0",
        "@napi-rs/canvas": "^1.1.0",
        "@types/archiver": "^7.0.0",
        "archiver": "^7.0.1",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "exifr": "7.1.3",
        "express": "^4.19.2",
        "express-rate-limit": "^7.4.0",
        "helmet": "^7.1.0",
        "jszip": "3.10.1",
        "morgan": "^1.10.0",
        "onnxruntime-node": "^1.31.1",
        "pdfkit": "github:manga-download/pdfkit#v0.17.2",
        "ppu-paddle-ocr": "^6.7.0",
        "protobufjs": "7.5.4",
        "puppeteer": "^24.29.0",
        "puppeteer-extra": "^3.3.6",
        "puppeteer-extra-plugin-stealth": "^2.11.2",
        "sharp": "^0.35.5",
        "swagger-ui-express": "^5.0.1",
        "undici-proxy": "^0.3.0",
        "winston": "^3.14.0",
        "yaml": "^2.6.1",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "5.5.0",
        "@types/compression": "^1.7.5",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsdom": "27.0.0",
        "@types/morgan": "^1.9.9",
        "@types/node": "^22.13.0",
        "@types/swagger-ui-express": "^4.1.6",
        "@types/wicg-file-system-access": "^2023.10.7",
        "eslint": "9.39.1",
        "eslint-plugin-tsdoc": "0.4.0",
        "jsdom": "27.1.0",
        "tsc-alias": "^1.8.10",
        "tslib": "2.8.1",
        "tsx": "^4.19.2",
        "typescript": "5.9.3",
        "typescript-eslint": "8.46.3",
        "vitest": "4.0.7",
        "vitest-mock-extended": "3.1.0"
    },
    "bin": {
        "download": "scripts/download.mjs"
    }
}
